# Kopyahin ang file na ito sa `.env` at palitan ang mga value.
# Ang `.env` ay nasa .gitignore — hindi ito maipu-push sa GitHub.

# Mahabang random na string. Gumawa ng bago:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=paste-a-64-character-random-hex-here

# Supabase connection string (Dashboard → Connect → Connection string)
# Halimbawa: postgresql://postgres.xxxx:password@aws-1-region.pooler.supabase.com:6543/postgres
DATABASE_URL=postgresql://user:password@host:5432/postgres
